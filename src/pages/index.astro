---
import EmptyState from '../components/EmptyState.astro';
import GitHubRepos from '../components/GitHubRepos';
import { categories, site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { entrySlug, getBlogPosts } from '../lib/content';

const posts = await getBlogPosts();

const latestPosts = posts.slice(0, 3);
const homepageCategories = categories.filter(({ slug }) => slug !== 'hobbies');
const categoryArt: Record<string, string> = {
  anime: '/images/Pixelmiku.png',
  music: '/images/categories/music.svg',
  games: '/images/categories/games.svg',
  shows: '/images/categories/shows.svg',
  movies: '/images/categories/movies.svg',
};
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Personal universe / online</p>
      <h1>Half <span class="saiyan">Saiyan.</span><br />Half Human.</h1>
      <p class="hero-intro">{site.intro}</p>
      <div class="button-row">
        <a class="button" href="/about">Read my file →</a>
      </div>
      <div class="hero-coordinates" aria-label="Site themes">
        <span>28.6139° N</span>
        <span>MUSIC / MOTION / MEDIA / MAKING</span>
      </div>
    </div>

    <div class="portrait-terminal">
      <div class="portrait-label">
        <span>SUBJECT_001</span>
        <span>LIVE</span>
      </div>
      <div class="portrait-frame">
        <img
          src="/images/profile.png"
          alt="A cheerful fantasy creature holding an orange"
        />
        <span class="portrait-reticle portrait-reticle--one" aria-hidden="true"
        ></span>
        <span class="portrait-reticle portrait-reticle--two" aria-hidden="true"
        ></span>
      </div>
      <div class="portrait-data">
        <span>AKSHAT SRIVASTAVA</span>
        <span>STATUS: CURIOUS</span>
      </div>
    </div>
  </section>

  <div class="ticker" aria-hidden="true">
    <div>
      <span>NOW BROADCASTING</span>
      <i>✦</i>
      <span>ANIME</span><i>✦</i><span>MUSIC</span><i>✦</i><span>GAMES</span><i
        >✦</i
      >
      <span>RUNNING</span><i>✦</i><span>BUILDING</span><i>✦</i><span
        >LEARNING</span
      >
    </div>
  </div>

  <section class="page-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Browse sectors</p>
        <h2>Everything I’m into.</h2>
      </div>
      <p>Reviews, favorites, and passing obsessions all live here.</p>
    </div>
    <div class="category-grid">
      {
        homepageCategories.map((category) => (
          <a class="category-card" href={`/explore/${category.slug}`}>
            <div class="category-art" aria-hidden="true">
              <img src={categoryArt[category.slug]} alt="" loading="lazy" />
            </div>
            <h3>{category.label}</h3>
          </a>
        ))
      }
    </div>
  </section>

  <section class="page-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Source control / GitHub</p>
        <h2>Things I’ve built.</h2>
      </div>
      <a
        class="text-link"
        href="https://github.com/akshatsri121"
        target="_blank"
        rel="me noreferrer">View GitHub profile →</a
      >
    </div>
    <GitHubRepos client:load />
  </section>

  <section class="page-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Written transmissions</p>
        <h2>Notes from the feed.</h2>
      </div>
      <a class="text-link" href="/blog">View all writing →</a>
    </div>
    {
      latestPosts.length ? (
        <div class="post-grid">
          {latestPosts.map((post) => (
            <a href={`/blog/${entrySlug(post.id)}`}>
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-IN')}
              </time>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </a>
          ))}
        </div>
      ) : (
        <EmptyState
          label="Draft buffer empty"
          title="Words will happen here."
          message="Essays, reviews, learning notes, and thoughts that survive long enough to become paragraphs will show up in this feed."
        />
      )
    }
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(19rem, 0.6fr);
    align-items: center;
    gap: clamp(2rem, 7vw, 7rem);
    min-height: min(760px, calc(100vh - 7rem));
    padding: clamp(4.5rem, 9vw, 8rem) clamp(0rem, 2vw, 2rem);
  }

  .hero h1 {
    margin-bottom: 1.5rem;
    text-shadow: 0 0 40px rgb(115 251 211 / 10%);
  }

  .hero h1 .saiyan {
    display: inline-block;
    color: #ffe969;
    -webkit-text-stroke: 1px #fff5a6;
    text-shadow:
      0 0 4px #fff8ba,
      0 0 12px #ffe100,
      0 0 28px #ffc400,
      0 0 58px rgb(255 145 0 / 75%);
    animation: saiyan-flicker 2.8s steps(1, end) infinite;
  }

  .hero-intro {
    max-width: 56ch;
    margin-bottom: 2rem;
    color: var(--muted);
    font-size: clamp(0.95rem, 1.5vw, 1.1rem);
  }

  .hero-coordinates {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 2rem;
    margin-top: 4rem;
    color: var(--faint);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
  }

  .portrait-terminal {
    position: relative;
    padding: 0.55rem;
    border: 1px solid var(--line-bright);
    background: var(--panel);
    box-shadow:
      14px 14px 0 rgb(115 251 211 / 7%),
      var(--shadow);
    transform: rotate(1.5deg);
  }

  .portrait-label,
  .portrait-data {
    display: flex;
    justify-content: space-between;
    padding: 0.45rem;
    color: var(--muted);
    font-size: 0.56rem;
    letter-spacing: 0.08em;
  }

  .portrait-label span:last-child {
    color: var(--mint);
  }

  .portrait-frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--line);
    background: #e3e1dc;
  }

  .portrait-frame::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgb(255 79 184 / 8%),
      transparent 30%,
      rgb(115 251 211 / 8%)
    );
    mix-blend-mode: multiply;
    content: '';
  }

  .portrait-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portrait-reticle {
    position: absolute;
    z-index: 2;
    width: 2.2rem;
    height: 2.2rem;
    border-top: 1px solid var(--pink);
    border-left: 1px solid var(--pink);
  }

  .portrait-reticle--one {
    top: 0.8rem;
    left: 0.8rem;
  }
  .portrait-reticle--two {
    right: 0.8rem;
    bottom: 0.8rem;
    transform: rotate(180deg);
  }

  .ticker {
    position: relative;
    left: 50%;
    width: 100vw;
    overflow: hidden;
    color: var(--black);
    background: var(--mint);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    transform: translateX(-50%) rotate(-1deg);
  }

  .ticker div {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 1.4rem;
    min-height: 2.5rem;
    padding: 0 2rem;
  }

  .ticker i {
    color: var(--pink);
    font-style: normal;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1rem;
  }

  .category-card {
    position: relative;
    display: flex;
    min-height: 0;
    aspect-ratio: 1;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    overflow: hidden;
    padding: 1.15rem;
    border: 0;
    background:
      radial-gradient(
        circle at 50% 32%,
        rgb(115 251 211 / 9%),
        transparent 34%
      ),
      repeating-linear-gradient(
        135deg,
        transparent 0 18px,
        rgb(115 251 211 / 2%) 18px 19px
      ),
      var(--panel);
    box-shadow: none;
    cursor: pointer;
    scroll-snap-align: start;
    text-decoration: none;
    transition:
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .category-card:hover,
  .category-card:focus-visible {
    box-shadow: 0 12px 28px rgb(0 255 98 / 9%);
    transform: translateY(-4px);
  }

  .category-art {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border: 0;
    background: #000;
  }
  .category-art::before {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(
        180deg,
        rgb(0 0 0 / 12%) 0%,
        transparent 42%,
        rgb(9 11 18 / 58%) 68%,
        var(--panel) 92%
      ),
      linear-gradient(
        90deg,
        rgb(9 11 18 / 42%) 0%,
        transparent 20%,
        transparent 80%,
        rgb(9 11 18 / 42%) 100%
      );
    content: '';
    pointer-events: none;
  }
  .category-art::after {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: repeating-linear-gradient(
      0deg,
      transparent 0 5px,
      rgb(0 0 0 / 16%) 5px 6px
    );
    content: '';
    pointer-events: none;
  }
  .category-art img {
    width: 78%;
    height: 78%;
    margin: 3% 11% 19%;
    object-fit: contain;
    opacity: 0.62;
    filter: brightness(0.68) saturate(0.82) contrast(1.05);
    image-rendering: pixelated;
  }
  .category-card h3 {
    position: relative;
    z-index: 4;
    width: 100%;
    margin: 0;
    padding: 0.75rem 0.25rem 0.15rem;
    font-size: clamp(1.25rem, 2vw, 1.7rem);
    text-align: center;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .post-grid > a {
    min-height: 15rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    background: var(--panel);
    text-decoration: none;
  }
  .post-grid time {
    color: var(--pink);
    font-size: 0.6rem;
  }
  .post-grid h3 {
    margin: 2.5rem 0 0.7rem;
  }
  .post-grid p {
    color: var(--muted);
  }

  @keyframes saiyan-flicker {
    0%,
    88%,
    94%,
    100% {
      filter: brightness(1);
      transform: translate(0);
    }
    89% {
      filter: brightness(1.8);
      transform: translateX(1px);
    }
    91% {
      filter: brightness(0.9);
      transform: translateX(-1px);
    }
  }

  @media (max-width: 850px) {
    .hero {
      grid-template-columns: 1fr 0.65fr;
      gap: 2rem;
    }
    .category-grid {
      grid-auto-columns: minmax(13rem, 38vw);
      grid-auto-flow: column;
      grid-template-columns: none;
      overflow-x: auto;
      padding: 0.25rem 0.25rem 1rem;
      scroll-snap-type: x proximity;
    }
    .post-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 650px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .portrait-terminal {
      width: min(100%, 20rem);
      margin: 1rem auto 0;
    }
    .hero-coordinates {
      margin-top: 2.5rem;
    }
    .ticker {
      display: none;
    }
    .category-grid {
      grid-auto-columns: minmax(12rem, 72vw);
    }
  }
</style>
