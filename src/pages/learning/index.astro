---
import EmptyState from '../../components/EmptyState.astro';
import PageIntro from '../../components/PageIntro.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entrySlug, getLearningEntries } from '../../lib/content';

const entries = await getLearningEntries();
---

<BaseLayout
  title="Learning and making"
  description="Akshat's project workbench, skill tree, and learning logs."
>
  <PageIntro
    eyebrow="Workbench / active experiments"
    title="Learning in public."
    description="PCB design, web design, unfinished experiments, useful mistakes, and proof that I know more than I did yesterday."
    count={entries.length}
  />
  <section class="page-section learning-section">
    {
      entries.length ? (
        <div class="learning-grid">
          {entries.map((entry, index) => (
            <article class="learning-card">
              <a href={`/learning/${entrySlug(entry.id)}`}>
                <div class="learning-card-top">
                  <span>JOB_{String(index + 1).padStart(3, '0')}</span>
                  <span>{entry.data.kind}</span>
                </div>
                <h2>{entry.data.title}</h2>
                <p>{entry.data.summary}</p>
                <div class="progress-line">
                  <span style={`width: ${entry.data.progress ?? 0}%`} />
                </div>
                <div class="learning-card-foot">
                  <span>{entry.data.status}</span>
                  <span>{entry.data.progress ?? 0}%</span>
                </div>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <EmptyState
          label="Workbench initialized"
          title="No build logs yet."
          message="The tools are laid out for PCB projects, web experiments, skill notes, and everything Akshat learns next."
        />
      )
    }
  </section>
</BaseLayout>

<style>
  .learning-section {
    margin-top: 3rem;
  }
  .learning-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .learning-card {
    border: 1px solid var(--line);
    background: var(--panel);
  }
  .learning-card:hover {
    border-color: var(--mint);
  }
  .learning-card > a {
    display: block;
    min-height: 21rem;
    padding: clamp(1.3rem, 4vw, 2.2rem);
    text-decoration: none;
  }
  .learning-card-top,
  .learning-card-foot {
    display: flex;
    justify-content: space-between;
    color: var(--faint);
    font-size: 0.62rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .learning-card-top span:last-child,
  .learning-card-foot span:first-child {
    color: var(--pink);
  }
  .learning-card h2 {
    margin: 4rem 0 0.8rem;
    font-size: clamp(2rem, 4vw, 3rem);
  }
  .learning-card p {
    color: var(--muted);
  }
  .progress-line {
    height: 0.3rem;
    margin: 2rem 0 0.7rem;
    background: var(--line);
  }
  .progress-line span {
    display: block;
    height: 100%;
    background: var(--mint);
    box-shadow: 0 0 8px var(--mint);
  }
  @media (max-width: 650px) {
    .learning-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
